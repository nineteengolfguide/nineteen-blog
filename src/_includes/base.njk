<!DOCTYPE html>
<html lang="de-CH">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} · NineteenGolf.Guide Blog</title>
  <meta name="description" content="{{ description or 'Der Golf-Blog von NineteenGolf.Guide: Reisen, Ausruestung, Plaetze und Geschichten rund ums Spiel.' }}">
  <style>
    :root {
      --ink: #1A1A1A;
      --gold: #C8A96E;
      --paper: #F7F7F5;
      --line: #E0E0E0;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      color: var(--ink);
      background: #FFFFFF;
      line-height: 1.6;
    }
    header {
      border-bottom: 3px solid var(--gold);
      padding: 1.5rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    header .brand {
      font-size: 1.3rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      text-decoration: none;
      color: var(--ink);
    }
    header .brand span { color: var(--gold); }
    nav a {
      margin-left: 1.5rem;
      color: var(--ink);
      text-decoration: none;
      font-size: 0.95rem;
    }
    nav a:hover { color: var(--gold); }
    main {
      max-width: 760px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem 4rem;
    }
    .hero {
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 2.5rem;
      margin-bottom: 2.5rem;
    }
    .hero h1 { margin-top: 0; font-size: 2rem; }
    /* Links im Inhalt an die Gold-Linie angleichen statt Browser-Blau. */
    main a {
      color: var(--ink);
      text-decoration: underline;
      text-decoration-color: var(--gold);
      text-underline-offset: 3px;
    }
    main a:hover { color: var(--gold); }
    .post-list a { text-decoration: none; }
    .post-list { list-style: none; padding: 0; }
    .post-list li {
      border-bottom: 1px solid var(--line);
      padding: 1.25rem 0;
    }
    .post-list a {
      color: var(--ink);
      text-decoration: none;
      font-size: 1.15rem;
      font-weight: 600;
    }
    .post-list a:hover { color: var(--gold); }
    .post-date { color: #8a8a8a; font-size: 0.85rem; }
    article h1 { font-size: 2rem; }
    footer {
      border-top: 1px solid var(--line);
      text-align: center;
      padding: 2rem;
      color: #8a8a8a;
      font-size: 0.85rem;
    }
    /* Auf schmalen Displays sollen die Nav-Links nicht am Rand kleben. */
    @media (max-width: 480px) {
      header { padding: 1.25rem; }
      nav a { margin-left: 0; margin-right: 1.25rem; }
    }
  </style>
</head>
<body>
  <header>
    <a class="brand" href="/">NINETEENGOLF<span>.</span>GUIDE</a>
    <nav>
      <a href="/">Start</a>
      <a href="/about/">Ueber uns</a>
      <a href="https://nineteengolf.guide">Hauptseite</a>
    </nav>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer>
    NineteenGolf.Guide Blog &middot; 2026
  </footer>
</body>
</html>
